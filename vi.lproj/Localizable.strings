"Extracted %lu file into %@. %lu symbolic links in the ZIP were left out." = "Đã giải nén %lu tệp vào %@. %lu liên kết tượng trưng trong ZIP đã bị bỏ qua.";
"Extracted %lu files into %@. %lu symbolic link in the ZIP was left out." = "Đã giải nén %lu tệp vào %@. %lu liên kết tượng trưng trong ZIP đã bị bỏ qua.";
